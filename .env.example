# Environment variables for the Bachelor thesis experiment.
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is gitignored and must never be committed. This template is safe to commit.
#
# NOTE: the code does not read these yet — wiring main.py/config.yaml to load
# them is the remaining "secrets -> env vars" cloud-readiness task (TODOS.md).

# --- Supabase (results logging) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# --- Market / fundamentals data APIs ---
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FMP_API_KEY=your-financial-modeling-prep-key
FINNHUB_API_KEY=your-finnhub-key

# --- FRED (macro series) ---
FRED_API_KEY=your-fred-key

# --- SEC EDGAR (per SEC policy, identify your app) ---
SEC_USER_AGENT=YourAppName/1.0 (your-email@example.com)
