# Copy to notify.env (same dir) and fill in. notify.env is gitignored — never commit it.
# GMAIL_APP_PASSWORD must be a 16-char Google "App password" (Account -> Security ->
# App passwords), NOT your normal login password. Spaces in the app password are
# cosmetic; strip them. App passwords are disposable — regenerate any time.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_TO=you@gmail.com
